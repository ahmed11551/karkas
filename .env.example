# Copy to .env and fill in real values. Never commit .env.

# Admin CRM. Password must be at least 12 characters.
# There is no built-in default. In development, login stays disabled until both values are set.
# In production (NODE_ENV=production) the server refuses to start without them.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Server bind. Use 127.0.0.1 for local-only, 0.0.0.0 inside a container.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Set to 1 only behind a trusted reverse proxy (correct client IP, HTTPS detection, HSTS).
# Required on Railway, Render and behind Nginx, otherwise rate limits see the proxy IP.
TRUST_PROXY=0

# Folder for data/leads.json. Empty = ./data inside the project.
# On hosting point it at a persistent volume (for example /app/data), otherwise leads are lost on redeploy.
DATA_DIR=

# Comma-separated browser origins allowed to call the API with credentials.
# Leave empty to allow only same-origin requests.
ALLOWED_ORIGINS=

# Yandex Metrika counter id (digits only). Empty = analytics disabled, nothing is loaded.
# Read at build time (VITE_ prefix), so rebuild after changing it. The server CSP allows
# mc.yandex.ru only while this is set. Goal "lead_sent" is sent on every successful lead.
VITE_YANDEX_METRIKA_ID=

# Telegram alert on every new lead (server-side only, never sent to the browser).
# Create a bot with @BotFather and take its token. Get the chat id of your group or
# channel (groups are negative numbers, e.g. -1001234567890). Both must be set; otherwise off.
# The message contains client name and phone, so keep the chat private.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Who may embed the site. Defaults to 'self' when empty.
# Example: 'self' https://aistudio.google.com
FRAME_ANCESTORS=
